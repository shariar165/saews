# Copy to .env and adjust. All settings use the EWS_ prefix (see backend/app/config.py).
EWS_ENVIRONMENT=development
EWS_DEMO_MODE=true

# SQLite (default) or PostgreSQL, e.g. postgresql+psycopg://saews:secret@localhost:5432/saews
# EWS_DATABASE_URL=sqlite:///./data/saews.db

# REQUIRED in production: a long random secret (python -c "import secrets; print(secrets.token_urlsafe(48))")
EWS_JWT_SECRET=change-me
EWS_COOKIE_SECURE=false          # true behind HTTPS
EWS_ACCESS_TOKEN_MINUTES=120
EWS_LOGIN_RATE_LIMIT=10/minute

# Risk thresholds (probability) and data-quality rules
EWS_RISK_THRESHOLD_MODERATE=0.20
EWS_RISK_THRESHOLD_HIGH=0.40
EWS_RISK_THRESHOLD_CRITICAL=0.65
EWS_MIN_DATA_COMPLETENESS=0.6
EWS_STALE_AFTER_DAYS=21

# Privacy
EWS_MIN_GROUP_SIZE=5
EWS_RETENTION_DAYS=730
EWS_AUDIT_RETENTION_DAYS=365

# Optional generative-AI assistant (Claude). Off unless both of these are set.
EWS_AI_ENABLED=false
# ANTHROPIC_API_KEY=sk-ant-...
# EWS_AI_MODEL=claude-opus-5-5
# EWS_AI_EFFORT=low
# EWS_AI_RATE_LIMIT=20/minute
